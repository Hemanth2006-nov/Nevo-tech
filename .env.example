# Local development only. Never commit your populated .env file.
APP_ENV=development
PORT=5000
DATABASE_URL=
SECRET_KEY=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# For production, enable Turnstile and configure both keys.
TURNSTILE_REQUIRED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Configure either email notifications or a webhook before production deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL_TO=
LEAD_WEBHOOK_URL=

# Use a shared Redis URL when running multiple processes or instances.
RATELIMIT_STORAGE_URI=memory://
TRUST_PROXY=false
LOG_LEVEL=INFO
